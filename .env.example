# BBFx asset pipeline — environment configuration
#
# Copy this file to `.env` and fill in your real values. The pipeline
# (tools/asset_pipeline.py) auto-loads the nearest `.env` at startup —
# you don't need to `export` anything yourself.
#
# Lookup order:
#   1. bbfx-revival/.env   (preferred — repo root)
#   2. bbfx-revival/tools/.env
#
# This file (`.env.example`) is committed and safe to share. The real
# `.env` is gitignored — never commit it.

# ── Cloudflare R2 (S3-compatible) credentials ────────────────────────────
# Created in: R2 dashboard → "Manage R2 API Tokens" → permission
# "Object Read & Write", scoped to the bbfx-assets bucket.
R2_ACCESS_KEY_ID=replace_with_your_key
R2_SECRET_ACCESS_KEY=replace_with_your_secret

# ── R2 bucket configuration ───────────────────────────────────────────────
# These three are read by `asset_pipeline.py upload` as defaults — you can
# also pass them via --bucket / --endpoint / --public-base on the command
# line to override.
R2_BUCKET=bbfx-assets
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE=https://pub-<hash>.r2.dev

# ── Stock-video API keys (optional — only needed for Lot J) ──────────────
# Pixabay (preferred): https://pixabay.com/api/docs/  — free, no attribution
# PIXABAY_API_KEY=replace_with_your_key
#
# Pexels (fallback): https://www.pexels.com/api/  — free, attribution welcomed
# PEXELS_API_KEY=replace_with_your_key
