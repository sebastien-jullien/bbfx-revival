# Build artefacts
build/
*.o
*.obj
*.lib
*.a
*.so
*.dll
*.exe

# vcpkg installed packages (can be rebuilt from vcpkg.json)
vcpkg_installed/

# CMake cache
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# IDE
.vs/
.vscode/settings.json
*.user
*.suo
.idea/

# OS
.DS_Store
Thumbs.db
desktop.ini

# BBFx Studio runtime state (generated, user-specific)
imgui.ini
node_editor.json
*.bbfx-session
*.bbfx-project.autosave
*.bbfx-project.bak
*.bbfx-project.tmp
bbfx.log

# FetchContent downloads (auto-fetched by CMake)
_deps/

# CMake bundlé — doc offline inutile dans le repo
extern/cmake/doc/

# Asset pipeline secrets (CDN credentials, API keys) — never commit
.env
tools/.env
tools/.pipeline/

# Python environments (local — managed externally via conda or venv)
.venv/
venv/
__pycache__/
*.pyc
