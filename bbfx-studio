#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$SCRIPT_DIR"
EXE="$REPO_ROOT/build/windows-debug/Debug/bbfx-studio.exe"

if [[ ! -f "$EXE" ]]; then
  echo "Executable not found: $EXE" >&2
  echo "Hint: ./bbfx-studio --build (from repo root)" >&2
  exit 1
fi

# Parse args: pass flags directly, resolve script paths.
# Flags avec valeur (--demo X, --deep-link URL, etc.) : la valeur N'EST PAS un
# script, donc ne pas tenter de la résoudre comme un chemin.
CMD_ARGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --demo|--deep-link|--install|--uninstall|--validate-plugin|--export-plugin)
      CMD_ARGS+=("$1")
      shift
      if [[ $# -gt 0 ]]; then
        CMD_ARGS+=("$1")
        shift
      fi
      ;;
    -*)
      CMD_ARGS+=("$1")
      shift
      ;;
    *)
      # Resolve script path relative to repo root
      if [[ -f "$REPO_ROOT/$1" ]]; then
        CMD_ARGS+=("$REPO_ROOT/$1")
      else
        CMD_ARGS+=("$1")
      fi
      shift
      ;;
  esac
done

cd "$REPO_ROOT"
exec "$EXE" "${CMD_ARGS[@]}"
