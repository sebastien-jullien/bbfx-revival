// BBFx VJ Materials — v3.5.1
// 8 stylized materials for VJ performance use

material BBFx/Chrome
{
    technique
    {
        pass
        {
            ambient 0.2 0.2 0.2
            diffuse 0.8 0.8 0.8
            specular 1.0 1.0 1.0 128
            texture_unit
            {
                env_map spherical
                filtering trilinear
            }
        }
    }
}

material BBFx/Neon
{
    technique
    {
        pass
        {
            ambient 0 0 0
            diffuse 0 0 0
            specular 0 0 0 0
            emissive 0.2 1.0 0.4
            // self_illumination (covered by emissive) 0.2 1.0 0.4
        }
    }
}

material BBFx/GlassVJ
{
    technique
    {
        pass
        {
            scene_blend alpha_blend
            depth_write off
            ambient 0.1 0.1 0.15
            diffuse 0.3 0.3 0.4 0.3
            specular 1.0 1.0 1.0 200
        }
    }
}

material BBFx/Wireframe
{
    technique
    {
        pass
        {
            polygon_mode wireframe
            ambient 0 0 0
            diffuse 0 0 0
            emissive 0.0 1.0 0.0
        }
    }
}

material BBFx/Hologram
{
    technique
    {
        pass
        {
            scene_blend add
            depth_write off
            ambient 0 0 0
            diffuse 0.1 0.3 0.8 0.6
            emissive 0.05 0.15 0.4
            specular 0 0 0 0
        }
    }
}

material BBFx/Emissive
{
    technique
    {
        pass
        {
            ambient 0 0 0
            diffuse 0 0 0
            specular 0 0 0 0
            emissive 1.0 1.0 1.0
            // self_illumination (covered by emissive) 1.0 1.0 1.0
        }
    }
}

material BBFx/Gradient
{
    technique
    {
        pass
        {
            ambient 0.5 0.5 0.5
            diffuse 1.0 1.0 1.0
            specular 0.3 0.3 0.3 32
        }
    }
}

material BBFx/Reflective
{
    technique
    {
        pass
        {
            ambient 0.1 0.1 0.1
            diffuse 0.5 0.5 0.5
            specular 1.0 1.0 1.0 200
            texture_unit
            {
                env_map spherical
                filtering trilinear
            }
        }
    }
}
