// BBFx Compositor Materials — fragment programs + materials for each compositor

// === Fragment Programs ===

fragment_program BBFx/Vignette_fp glsl
{
    source vignette.frag
    default_params
    {
        param_named tex0 int 0
        param_named strength float 0.8
    }
}

fragment_program BBFx/FilmGrain_fp glsl
{
    source filmgrain.frag
    default_params
    {
        param_named tex0 int 0
        param_named time float 0
        param_named intensity float 0.3
    }
}

fragment_program BBFx/Invert_fp glsl
{
    source invert.frag
    default_params
    {
        param_named tex0 int 0
    }
}

fragment_program BBFx/Posterize_fp glsl
{
    source posterize.frag
    default_params
    {
        param_named tex0 int 0
        param_named levels float 6.0
    }
}

fragment_program BBFx/EdgeDetect_fp glsl
{
    source edge_detect.frag
    default_params
    {
        param_named tex0 int 0
    }
}

fragment_program BBFx/Pixelate_fp glsl
{
    source pixelate.frag
    default_params
    {
        param_named tex0 int 0
        param_named pixel_size float 8.0
    }
}

fragment_program BBFx/Barrel_fp glsl
{
    source barrel.frag
    default_params
    {
        param_named tex0 int 0
        param_named distortion float 0.3
    }
}

fragment_program BBFx/Kaleidoscope_fp glsl
{
    source kaleidoscope.frag
    default_params
    {
        param_named tex0 int 0
        param_named time float 0
        param_named segments float 6.0
        param_named rotation float 0
        param_named zoom float 1.0
    }
}

fragment_program BBFx/ChromaticAberration_fp glsl
{
    source chromatic_aberration.frag
    default_params
    {
        param_named tex0 int 0
        param_named intensity float 5.0
        param_named falloff float 2.0
    }
}

fragment_program BBFx/VHS_fp glsl
{
    source vhs.frag
    default_params
    {
        param_named tex0 int 0
        param_named time float 0
        param_named tracking float 1.0
        param_named noise_amount float 0.1
        param_named color_bleed float 1.0
        param_named scanline float 1.0
    }
}

fragment_program BBFx/HeatDistort_fp glsl
{
    source wave_deform.frag
    default_params
    {
        param_named tex0 int 0
        param_named time float 0
        param_named amplitude float 0.01
        param_named frequency float 10.0
        param_named speed float 1.0
    }
}

fragment_program BBFx/ASCII_fp glsl
{
    source ascii_art.frag
    default_params
    {
        param_named tex0 int 0
        param_named char_size float 8.0
        param_named brightness float 1.0
    }
}

// EdgeBlend — gamma-corrected edge fade for multi-projector overlap (v3.4)
fragment_program BBFx/EdgeBlend_fp glsl
{
    source edge_blend.frag
    default_params
    {
        param_named tex0         int   0
        param_named blend_left   float 0.0
        param_named blend_right  float 0.0
        param_named blend_top    float 0.0
        param_named blend_bottom float 0.0
        param_named blend_gamma  float 2.2
    }
}

// QuadWarp — 4-corner inverse bilinear warp for projection calibration (v3.4)
fragment_program BBFx/QuadWarp_fp glsl
{
    source quad_warp.frag
    default_params
    {
        param_named tex0  int   0
        param_named tl_x  float 0.0
        param_named tl_y  float 0.0
        param_named tr_x  float 1.0
        param_named tr_y  float 0.0
        param_named bl_x  float 0.0
        param_named bl_y  float 1.0
        param_named br_x  float 1.0
        param_named br_y  float 1.0
    }
}

// MotionTrail uses filmgrain shader as approximation (blur effect)
fragment_program BBFx/MotionTrail_fp glsl
{
    source filmgrain.frag
    default_params
    {
        param_named tex0 int 0
        param_named time float 0
        param_named intensity float 0.05
    }
}

// Bloom — single-pass threshold + gaussian blur + additive blend (v3.5.1)
fragment_program BBFx/Bloom_fp glsl
{
    source bloom.frag
    default_params
    {
        param_named tex0 int 0
        param_named threshold float 0.7
        param_named intensity float 1.5
        param_named blur_size float 3.0
    }
}

// DOF — single-pass variable-radius blur based on focus distance (v3.5.1)
fragment_program BBFx/DOF_fp glsl
{
    source dof.frag
    default_params
    {
        param_named tex0 int 0
        param_named focus float 0.5
        param_named range float 0.3
        param_named blur_amount float 5.0
    }
}

// BlackAndWhite — luminance desaturation (v3.5.1)
fragment_program BBFx/BlackAndWhite_fp glsl
{
    source BlackAndWhite.glsl
    default_params
    {
        param_named tex0 int 0
    }
}

// Embossed — edge emboss with auto texelSize (v3.5.1)
fragment_program BBFx/Embossed_fp glsl
{
    source bbfx_embossed.frag
    default_params
    {
        param_named tex0 int 0
    }
}

// OldTV — vintage TV distortion with procedural noise (v3.5.1)
fragment_program BBFx/OldTV_fp glsl
{
    source bbfx_oldtv.frag
    default_params
    {
        param_named tex0 int 0
        param_named time float 0
        param_named distortionFreq float 2.7
        param_named distortionScale float 2.5
        param_named distortionRoll float 0.93
        param_named interference float 0.5
        param_named frameLimit float 0.40
        param_named frameSharpness float 6.0
    }
}

// Glass — procedural water distortion (v3.5.1)
fragment_program BBFx/Glass_fp glsl
{
    source bbfx_glass.frag
    default_params
    {
        param_named tex0 int 0
        param_named time float 0
        param_named distortion float 5.0
        param_named speed float 1.0
    }
}

// === Materials ===

material BBFx/EdgeBlend
{
    technique
    {
        pass
        {
            depth_check off
            vertex_program_ref StdQuad_vp_glsl {}
            fragment_program_ref BBFx/EdgeBlend_fp {}
            texture_unit RT
            {
                tex_address_mode clamp
                filtering linear linear none
            }
        }
    }
}

material BBFx/QuadWarp
{
    technique
    {
        pass
        {
            depth_check off
            vertex_program_ref StdQuad_vp_glsl {}
            fragment_program_ref BBFx/QuadWarp_fp {}
            texture_unit RT
            {
                tex_address_mode clamp
                filtering linear linear none
            }
        }
    }
}

