// === v3.5.1 Lot H — New Post-Process Effects ===

// Halftone — CMYK-style dot pattern (v3.5.1)
fragment_program BBFx/Halftone_fp glsl
{
    source halftone.frag
    default_params
    {
        param_named tex0 int 0
        param_named dot_size float 0.01
        param_named angle float 45.0
    }
}

material BBFx/Halftone
{
    technique
    {
        pass
        {
            depth_check off
            vertex_program_ref StdQuad_vp_glsl {}
            fragment_program_ref BBFx/Halftone_fp {}
            texture_unit RT
            {
                tex_address_mode clamp
                filtering linear linear none
            }
        }
    }
}

// CrossHatch — pencil hatching effect (v3.5.1)
fragment_program BBFx/CrossHatch_fp glsl
{
    source cross_hatch.frag
    default_params
    {
        param_named tex0 int 0
        param_named line_density float 50.0
        param_named threshold float 0.8
    }
}

material BBFx/CrossHatch
{
    technique
    {
        pass
        {
            depth_check off
            vertex_program_ref StdQuad_vp_glsl {}
            fragment_program_ref BBFx/CrossHatch_fp {}
            texture_unit RT
            {
                tex_address_mode clamp
                filtering linear linear none
            }
        }
    }
}

// OilPaint — Kuwahara filter (v3.5.1)
fragment_program BBFx/OilPaint_fp glsl
{
    source oil_paint.frag
    default_params
    {
        param_named tex0 int 0
        param_named radius float 4.0
    }
}

material BBFx/OilPaint
{
    technique
    {
        pass
        {
            depth_check off
            vertex_program_ref StdQuad_vp_glsl {}
            fragment_program_ref BBFx/OilPaint_fp {}
            texture_unit RT
            {
                tex_address_mode clamp
                filtering linear linear none
            }
        }
    }
}

// ColorLUT — parametric color grading (v3.5.1)
fragment_program BBFx/ColorLUT_fp glsl
{
    source color_lut.frag
    default_params
    {
        param_named tex0 int 0
        param_named lut_intensity float 1.0
        param_named temperature float 0.0
        param_named tint float 0.0
        param_named contrast float 0.0
        param_named saturation float 0.0
    }
}

material BBFx/ColorLUT
{
    technique
    {
        pass
        {
            depth_check off
            vertex_program_ref StdQuad_vp_glsl {}
            fragment_program_ref BBFx/ColorLUT_fp {}
            texture_unit RT
            {
                tex_address_mode clamp
                filtering linear linear none
            }
        }
    }
}

// RadialBlur — radial zoom blur from center point (v3.5.1)
fragment_program BBFx/RadialBlur_fp glsl
{
    source radial_blur.frag
    default_params
    {
        param_named tex0 int 0
        param_named center_x float 0.5
        param_named center_y float 0.5
        param_named intensity float 5.0
        param_named samples float 16.0
    }
}

material BBFx/RadialBlur
{
    technique
    {
        pass
        {
            depth_check off
            vertex_program_ref StdQuad_vp_glsl {}
            fragment_program_ref BBFx/RadialBlur_fp {}
            texture_unit RT
            {
                tex_address_mode clamp
                filtering linear linear none
            }
        }
    }
}

// FeedbackZoom — temporal feedback with zoom/rotation (v3.5.1)
fragment_program BBFx/FeedbackZoom_fp glsl
{
    source feedback_zoom.frag
    default_params
    {
        param_named tex0 int 0
        param_named prevFrame int 1
        param_named decay float 0.5
        param_named zoom float 1.0
        param_named rotation float 0.5
    }
}

material BBFx/FeedbackZoom
{
    technique
    {
        pass
        {
            depth_check off
            vertex_program_ref StdQuad_vp_glsl {}
            fragment_program_ref BBFx/FeedbackZoom_fp {}
            texture_unit RT
            {
                tex_address_mode clamp
                filtering linear linear none
            }
            texture_unit PrevFrame
            {
                tex_address_mode clamp
                filtering linear linear none
            }
        }
    }
}

// MotionTrail (feedback) — real temporal trails using prevFrame (v3.5.1)
// Replaces the filmgrain approximation
fragment_program BBFx/MotionTrailFB_fp glsl
{
    source pp_motion_trail.frag
    default_params
    {
        param_named tex0 int 0
        param_named prevFrame int 1
        param_named trail_decay float 0.3
    }
}

material BBFx/MotionTrailFB
{
    technique
    {
        pass
        {
            depth_check off
            vertex_program_ref StdQuad_vp_glsl {}
            fragment_program_ref BBFx/MotionTrailFB_fp {}
            texture_unit RT
            {
                tex_address_mode clamp
                filtering linear linear none
            }
            texture_unit PrevFrame
            {
                tex_address_mode clamp
                filtering linear linear none
            }
        }
    }
}
