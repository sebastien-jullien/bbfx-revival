// BBFx Skybox Materials — extracted from original OGRE media packs
// All textures in resources/materials/textures/skybox/

material BBFx/StormySkyBox
{
	technique
	{
		pass
		{
			lighting off
			depth_write off

			texture_unit
			{
				cubic_texture stormy_FR.jpg stormy_BK.jpg stormy_UP.jpg stormy_DN.jpg stormy_LF.jpg stormy_RT.jpg separateUV
				tex_address_mode clamp
			}
		}
	}
}

