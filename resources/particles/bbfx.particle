// BBFx Custom Particle Templates
// Designed for Studio viewport: camera at ~50 units from origin, looking at (0,0,0)
// VJ-style dramatic effects — large particles, visible from orbit distance

particle_system BBFx/StarField
{
    material        Examples/Flare
    particle_width  10
    particle_height 10
    cull_each       false
    quota           2000
    billboard_type  point

    emitter Box
    {
        angle           180
        emission_rate   100
        time_to_live    20
        direction       0 0 -1
        velocity        5
        width           120
        height          120
        depth           120
        colour_range_start  0.7 0.7 1.0
        colour_range_end    1.0 1.0 0.8
    }
}

particle_system BBFx/SparkBurst
{
    material        Examples/Flare2
    particle_width  20
    particle_height 40
    cull_each       false
    quota           500
    billboard_type  oriented_self

    emitter Point
    {
        angle           180
        emission_rate   200
        time_to_live    1.2
        direction       0 1 0
        velocity_min    60
        velocity_max    180
        colour_range_start  1 1 0.3
        colour_range_end    1 0.3 0
    }

    affector LinearForce
    {
        force_vector      0 -80 0
        force_application add
    }

    affector ColourFader
    {
        red -0.4
        green -0.8
        blue -0.4
    }
}

particle_system BBFx/Snowfall
{
    material        Examples/Flare
    particle_width  8
    particle_height 8
    cull_each       false
    quota           1000
    billboard_type  point

    emitter Box
    {
        angle           0
        emission_rate   80
        time_to_live    10
        direction       0 -1 0
        velocity        10
        position        0 60 0
        width           100
        height          1
        depth           100
        colour_range_start  0.9 0.9 1.0
        colour_range_end    1.0 1.0 1.0
    }

    affector DirectionRandomiser
    {
        randomness      5
    }
}
