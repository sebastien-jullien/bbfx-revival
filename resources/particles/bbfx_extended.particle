// BBFx Extended Particle Templates
// I-1582: Fire, ElectricArc, Confetti
// I-1583: MagicDust, NeonTrail, Bubbles
// I-1584: LaserBeam, Galaxy, MatrixRain
// I-1585: ParticleTunnel
// I-1674: Recalibrated all sizes for camera at 50 units — VJ dramatic style

particle_system BBFx/Fire
{
    material        Examples/Flare
    particle_width  25
    particle_height 25
    cull_each       false
    quota           500
    billboard_type  point

    emitter Point
    {
        angle           30
        emission_rate   100
        time_to_live    2.0
        direction       0 1 0
        velocity_min    20
        velocity_max    60
        colour          1.0 0.6 0.1
    }

    affector LinearForce
    {
        force_vector      0 -30 0
        force_application add
    }

    affector ColourFader
    {
        red   -0.2
        green -0.5
        blue  -0.05
        alpha -0.4
    }

    affector Scaler
    {
        rate -5
    }
}

particle_system BBFx/ElectricArc
{
    material        Examples/Flare2
    particle_width  8
    particle_height 50
    cull_each       false
    quota           300
    billboard_type  oriented_self

    emitter Point
    {
        angle           8
        emission_rate   200
        time_to_live    0.4
        direction       0 1 0
        velocity_min    200
        velocity_max    400
        colour          0.5 0.8 1.0
    }

    affector ColourFader
    {
        red   0.5
        green 0.2
        blue  0.0
        alpha -2.5
    }
}

particle_system BBFx/Confetti
{
    material        Examples/Flare
    particle_width  12
    particle_height 12
    cull_each       false
    quota           500
    billboard_type  point

    emitter Box
    {
        angle           180
        emission_rate   80
        time_to_live    5
        direction       0 1 0
        velocity_min    15
        velocity_max    50
        width           50
        height          1
        depth           50
        position        0 30 0
        colour_range_start  1.0 0.2 0.2
        colour_range_end    0.2 0.2 1.0
    }

    affector LinearForce
    {
        force_vector      0 -40 0
        force_application add
    }

    affector Rotator
    {
        rotation_speed_range_start  -180
        rotation_speed_range_end    180
        rotation_range_start        0
        rotation_range_end          360
    }
}

particle_system BBFx/MagicDust
{
    material        Examples/Flare
    particle_width  10
    particle_height 10
    cull_each       false
    quota           500
    billboard_type  point

    emitter Box
    {
        angle           180
        emission_rate   80
        time_to_live    6
        direction       0 1 0
        velocity_min    3
        velocity_max    8
        width           40
        height          40
        depth           40
        colour_range_start  0.8 0.6 1.0
        colour_range_end    0.6 1.0 0.8
    }

    affector ColourFader
    {
        alpha -0.12
    }

    affector DirectionRandomiser
    {
        randomness      5
    }
}

particle_system BBFx/NeonTrail
{
    material        Examples/Flare2
    particle_width  8
    particle_height 50
    cull_each       false
    quota           300
    billboard_type  oriented_self
    renderer        billboard

    emitter Point
    {
        angle           12
        emission_rate   150
        time_to_live    1.0
        direction       0 0 -1
        velocity_min    60
        velocity_max    100
        colour          0.2 1.0 0.3
    }

    affector ColourFader
    {
        red   -0.1
        green -0.4
        blue  0.3
        alpha -0.8
    }
}

particle_system BBFx/Bubbles
{
    material        Examples/Flare
    particle_width  15
    particle_height 15
    cull_each       false
    quota           200
    billboard_type  point

    emitter Box
    {
        angle           30
        emission_rate   30
        time_to_live    8
        direction       0 1 0
        velocity_min    5
        velocity_max    15
        width           40
        height          1
        depth           40
        colour          0.6 0.8 1.0 0.6
    }

    affector Scaler
    {
        rate 4
    }

    affector DirectionRandomiser
    {
        randomness      3
    }
}

particle_system BBFx/LaserBeam
{
    material        Examples/Flare2
    particle_width  4
    particle_height 80
    cull_each       false
    quota           150
    billboard_type  oriented_self

    emitter Point
    {
        angle           2
        emission_rate   120
        time_to_live    0.5
        direction       0 0 -1
        velocity        400
        colour          0.1 1.0 0.1
    }

    affector ColourFader
    {
        alpha -1.5
    }
}

particle_system BBFx/Galaxy
{
    material        Examples/Flare
    particle_width  12
    particle_height 12
    cull_each       false
    quota           1500
    billboard_type  point

    emitter Box
    {
        angle           180
        emission_rate   150
        time_to_live    10
        direction       0 1 0
        velocity_min    8
        velocity_max    25
        width           60
        height          8
        depth           60
        colour_range_start  1.0 0.5 0.2
        colour_range_end    0.3 0.5 1.0
    }

    affector Rotator
    {
        rotation_speed_range_start  -90
        rotation_speed_range_end    90
        rotation_range_start        0
        rotation_range_end          360
    }

    affector DirectionRandomiser
    {
        randomness      5
    }
}

particle_system BBFx/MatrixRain
{
    material        Examples/Flare
    particle_width  10
    particle_height 10
    cull_each       false
    quota           2000
    billboard_type  point

    emitter Box
    {
        angle           0
        emission_rate   250
        time_to_live    4
        direction       0 -1 0
        velocity_min    40
        velocity_max    80
        width           100
        height          1
        depth           100
        position        0 60 0
        colour          0.0 1.0 0.0
    }

    affector ColourFader
    {
        green -0.15
        alpha -0.2
    }
}

particle_system BBFx/ParticleTunnel
{
    material        Examples/Flare
    particle_width  10
    particle_height 10
    cull_each       false
    quota           3000
    billboard_type  point

    emitter Ring
    {
        angle           5
        emission_rate   400
        time_to_live    3.0
        direction       0 0 -1
        velocity_min    60
        velocity_max    100
        width           30
        height          30
        depth           1
        colour_range_start  0.5 0.5 1.0
        colour_range_end    1.0 0.5 1.0
    }

    affector ColourFader
    {
        alpha -0.25
    }
}
