{
  "name": "Switch Pro - Performance",
  "deviceType": "SwitchPro",
  "description": "Gyro-steered camera, dpad scene switcher, sticks for dual parameter control.",
  "mappings": [
    { "source": "gyroX",        "target": "camera.rotY",      "scale": 0.025, "offset": 0.0, "invert": false },
    { "source": "gyroZ",        "target": "camera.rotX",      "scale": 0.025, "offset": 0.0, "invert": false },
    { "source": "leftStickX",   "target": "param.hueShift",   "scale": 180.0, "offset": 0.0, "invert": false },
    { "source": "leftStickY",   "target": "param.intensity",  "scale": 1.0,   "offset": 0.0, "invert": true  },
    { "source": "rightStickX",  "target": "param.warpStrength","scale": 1.0,  "offset": 0.0, "invert": false },
    { "source": "rightStickY",  "target": "param.feedback",   "scale": 1.0,   "offset": 0.0, "invert": true  },
    { "source": "dpadUp",       "target": "scene.next",       "scale": 1.0,   "offset": 0.0, "invert": false },
    { "source": "dpadDown",     "target": "scene.prev",       "scale": 1.0,   "offset": 0.0, "invert": false },
    { "source": "dpadLeft",     "target": "scene.back",       "scale": 1.0,   "offset": 0.0, "invert": false },
    { "source": "dpadRight",    "target": "scene.forward",    "scale": 1.0,   "offset": 0.0, "invert": false },
    { "source": "rightTrigger", "target": "fx.burst",         "scale": 1.0,   "offset": 0.0, "invert": false }
  ]
}
